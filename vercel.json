{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/cms", "destination": "/index.html" },
    { "source": "/cms/(.*)", "destination": "/index.html" },
    { "source": "/((?!assets/|logo.png|favicon.ico|.*\\..*).*)", "destination": "/index.html" }
  ]
}
